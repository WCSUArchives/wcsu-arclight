<%
  valid_embeddable = embeddable_resources.select { |r| r.href.to_s.start_with?('http://', 'https://') }
  valid_linked = linked_resources.select { |r| r.href.to_s.start_with?('http://', 'https://') }
%>

<% if valid_embeddable.any? || valid_linked.any? %>
<div id="embed" class="mb-2">
  <h2 class="al-show-sub-heading"><%= t('arclight.views.show.embedded_content') %></h2>

  <% valid_embeddable.each do |resource| %>
    <% href = resource.href.to_s %>
    <% iiif_patterns = ['/iiif/', '/manifests/', 'manifest.json', '/iiif-p/manifest'] %>
    <% if iiif_patterns.none? { |p| href.include?(p) } %>
      <%# Not a IIIF manifest — render as a plain link and skip viewer %>
      <div class="al-digital-object mb-2">
        <%= link_to resource.label, href, target: "_blank", class: "btn btn-outline-primary btn-sm" %>
      </div>
      <% next %>
    <% end %>

    <%
      if href.include?('/omeka-s/iiif/')
        manifest_id = href.match(/iiif\/3\/(\d+)\/manifest/)&.[](1)
        display_url = manifest_id ? "https://archives.library.wcsu.edu/omeka-s/s/digital/item/#{manifest_id}" : href
      elsif href.include?('ctdigitalarchive.org') && href.include?('/iiif-p/manifest')
        display_url = href.gsub('/iiif-p/manifest', '')
      elsif href.include?('collections.library.yale.edu') && href.include?('/manifests/')
        yale_id = href.match(/\/manifests\/(\d+)\.json$/)&.[](1)
        display_url = yale_id ? "https://collections.library.yale.edu/catalog/#{yale_id}" : href
      else
        display_url = href
      end
      begin
        domain = URI.parse(href).host || 'this site'
      rescue URI::Error
        domain = 'this site'
      end
    %>

    <div class="mirador-probe-wrapper"
         data-display-url="<%= display_url %>"
         data-domain="<%= domain %>">

      <div class="viewer-container">
        <%= render Arclight::OembedViewerComponent.new(resource: resource, document: @document) %>
      </div>

      <div class="probe-overlay">
        <div class="probe-loading">
          <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
          <span class="ms-2">Loading viewer&hellip;</span>
        </div>

        <div class="probe-auth d-none">
          <div class="alert alert-info" role="alert">
            <h5 class="alert-heading">External Authentication Required</h5>
            <p>
              This item is hosted by <strong><%= domain %></strong>.
              Their security system requires a quick verification before the viewer can load.
            </p>
            <hr>
            <p class="mb-0">
              <a href="<%= display_url %>" target="_blank" class="btn btn-primary btn-sm">
                Click here to verify and open this item
              </a>
            </p>
            <p class="mt-2 mb-0 small text-muted">
              After verifying, return to this page and <strong>refresh</strong> to load the viewer.
            </p>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <% valid_linked.each do |resource| %>
    <div class="al-digital-object mb-2">
      <%
        href = resource.href.to_s
        if href.include?('/omeka-s/iiif/')
          manifest_id = href.match(/iiif\/3\/(\d+)\/manifest/)&.[](1)
          display_url = manifest_id ? "https://archives.library.wcsu.edu/omeka-s/s/digital/item/#{manifest_id}" : href
        elsif href.include?('ctdigitalarchive.org') && href.include?('/iiif-p/manifest')
          display_url = href.gsub('/iiif-p/manifest', '')
        elsif href.include?('collections.library.yale.edu') && href.include?('/manifests/')
          yale_id = href.match(/\/manifests\/(\d+)\.json$/)&.[](1)
          display_url = yale_id ? "https://collections.library.yale.edu/catalog/#{yale_id}" : href
        else
          display_url = href
        end
      %>
      <%= link_to resource.label, display_url, target: "_blank", class: "btn btn-outline-primary btn-sm" %>
    </div>
  <% end %>

</div>
<% end %>

<style>
  .mirador-probe-wrapper {
    position: relative;
    min-height: 300px;
    margin-bottom: 1rem;
  }
  .probe-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: white;
    z-index: 10;
    padding: 1rem;
    min-height: 300px;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.mirador-probe-wrapper').forEach(function(wrapper) {
    var displayUrl = wrapper.dataset.displayUrl;
    var domain = wrapper.dataset.domain;
    var overlay = wrapper.querySelector('.probe-overlay');
    var loading = overlay.querySelector('.probe-loading');
    var auth = overlay.querySelector('.probe-auth');

    var resolved = false;

    function showSuccess() {
      if (resolved) return;
      resolved = true;
      overlay.remove();
    }

    function showAuthBox() {
      if (resolved) return;
      resolved = true;
      loading.classList.add('d-none');
      auth.classList.remove('d-none');
    }

    var checkInterval = setInterval(function() {
      var success = wrapper.querySelector('.mirador-workspace-viewport, video');
      var error = wrapper.querySelector('[role="alert"].MuiAlert-root');

      if (success) {
        clearInterval(checkInterval);
        showSuccess();
      } else if (error) {
        clearInterval(checkInterval);
        showAuthBox();
      }
    }, 300);

    setTimeout(function() {
      clearInterval(checkInterval);
      showAuthBox();
    }, 12000);
  });
});
</script>
